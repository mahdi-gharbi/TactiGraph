TACTIGRAPH_DATABASE_URL=sqlite:///data/tactigraph.db
TACTIGRAPH_DATA_DIR=data
TACTIGRAPH_MODE=local
TACTIGRAPH_FRONTEND_DIR=frontend/dist
# Optional local claim selection. Require the installed qwen3:4b SHA-256 from /api/tags.
TACTIGRAPH_OLLAMA_URL=http://127.0.0.1:11434
TACTIGRAPH_OLLAMA_DIGEST=
TACTIGRAPH_OLLAMA_TIMEOUT_SECONDS=30
# Optional Groq selection. Backend only: never use a VITE_ variable for this key.
GROQ_API_KEY=
TACTIGRAPH_GROQ_MODEL=openai/gpt-oss-20b
TACTIGRAPH_GROQ_TIMEOUT_SECONDS=20
# Docker Compose uses PostgreSQL. Public mode disables full event retrieval.
